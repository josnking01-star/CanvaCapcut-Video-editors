{
  "name": "canvacapcut-universal-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/bulkEngine.test.ts src/utils/licensing.test.ts src/utils/pricingEngine.test.ts src/utils/rbac.test.ts",
    "build:electron": "electron-builder --windows --x64",
    "package:win": "vite build && electron-builder --windows --x64"
  },
  "main": "electron/main.cjs",
  "buildConfig": {
    "appId": "com.omnicut.studioelite",
    "productName": "OmniCut Studio Elite",
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "${productName}_Setup_v${version}.${ext}"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
